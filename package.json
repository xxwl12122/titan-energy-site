{
  "name": "titan-energy-site",
  "version": "1.0.0",
  "private": true,
  "description": "泰坦供能品牌站，附带 Node.js 联系表单后端",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "build:css": "npx -y lightningcss-cli --minify --bundle assets/styles/main.css -o assets/styles/main.min.css",
    "build:js": "npx -y esbuild assets/scripts/main.js --bundle --minify --outfile=assets/scripts/main.min.js",
    "minify": "npm run build:css && npm run build:js"
  },
  "engines": {
    "node": ">=18"
  }
}
